# BestTask web app settings. Copy to web/.env and adjust; every value is
# optional for local development. Real environment variables (for example the
# ones docker-compose.yml sets) take priority over this file.

# ── Production (set these in Vercel) ─────────────────────────────────────────

# The API's base URL, ending in /api. Read when the app is built, so redeploy
# after changing it. The API must list the web app's origin in CORS_ORIGIN.
# Leave unset in development: the app then calls /api on the dev server, which
# forwards it to API_PROXY_TARGET below (no CORS setup needed).
# VITE_API_URL=https://api.example.com/api

# ── Development only (read by the Vite dev server) ───────────────────────────

# Where the dev server forwards /api. Defaults to http://localhost:4000.
# Compose sets http://api:4000.
# API_PROXY_TARGET=http://localhost:4000

# Poll for file changes. Needed when file events don't arrive, as with Docker
# Desktop bind mounts (Compose sets it); leave off when running on the host.
# VITE_POLLING=true
