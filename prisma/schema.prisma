generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Loads nested `include`s with SQL joins in one query instead of one query
  // per relation level. Each round trip to the hosted database costs ~55ms.
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  WORKSPACE_OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  name         String
  passwordHash String
  avatar       String?
  jobTitle     String   @default("")
  bio          String   @default("")
  timezone     String   @default("Asia/Dhaka")
  theme        String   @default("system")
  startPage    String   @default("board")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         Membership[]
  refreshTokens       RefreshToken[]
  createdTasks        Task[]          @relation("TaskCreator")
  assignedTasks       Task[]          @relation("TaskAssignee")
  comments            Comment[]
  activity            ActivityEvent[]
  ownedWorkspaces     Workspace[]     @relation("WorkspaceOwner")
  savedViews          SavedView[]
  notifications       Notification[]  @relation("NotificationRecipient")
  causedNotifications Notification[]  @relation("NotificationActor")
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  projects      Project[]
  activity      ActivityEvent[]
  notifications Notification[]
  owner         User            @relation("WorkspaceOwner", fields: [ownerId], references: [id])
}

model Membership {
  id          String    @id @default(uuid(7))
  userId      String
  workspaceId String
  active      Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  ProjectMembership[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Project {
  id              String        @id @default(uuid(7))
  workspaceId     String
  name            String
  key             String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  archivedAt      DateTime?
  deletedAt       DateTime?
  color           String        @default("#0E7490")
  seats           Int           @default(10)
  sequence        Int           @default(0)
  defaultStatus   TaskStatus    @default(TODO)
  defaultPriority Priority      @default(MEDIUM)
  showCancelled   Boolean       @default(true)
  wipLimit        Int           @default(0)
  cardFields      Json          @default("{\"assignee\":true,\"due\":true,\"labels\":true,\"subtasks\":true,\"comments\":true}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks      Task[]
  members    ProjectMembership[]
  labels     Label[]
  savedViews SavedView[]
  channels   Channel[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model ProjectMembership {
  projectId    String
  membershipId String
  role         Role       @default(MEMBER)
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([projectId, membershipId])
  @@index([membershipId])
}

model Task {
  id           String     @id @default(uuid(7))
  projectId    String
  title        String
  description  String?
  status       TaskStatus @default(BACKLOG)
  priority     Priority   @default(MEDIUM)
  creatorId    String
  assigneeId   String?
  parentTaskId String?
  dueDate      DateTime?
  completedAt  DateTime?
  position     Int        @default(0)
  number       Int
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parentTask    Task?          @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]         @relation("TaskSubtasks")
  labels        TaskLabel[]
  comments      Comment[]
  notifications Notification[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([creatorId])
  @@index([dueDate])
}

model Label {
  id        String    @id @default(uuid(7))
  projectId String
  deletedAt DateTime?
  name      String
  color     String    @default("#6b7280")
  createdAt DateTime  @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([projectId, name])
}

/// A project chat channel. Only channels are stored: messages are relayed
/// live over the socket (src/lib/realtime.ts) and never written anywhere.
/// Every project has one default channel (#general), created with it.
model Channel {
  id        String    @id @default(uuid(7))
  projectId String
  name      String
  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model TaskLabel {
  taskId    String
  labelId   String
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Comment {
  id        String    @id @default(uuid(7))
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
}

model ActivityEvent {
  id          String   @id @default(uuid(7))
  workspaceId String
  projectId   String?
  actorId     String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model SavedView {
  id        String   @id @default(uuid(7))
  userId    String
  projectId String
  name      String
  filters   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
}

model Recovery {
  id          String   @id @default(uuid(7))
  actorId     String
  workspaceId String
  projectId   String?
  entityType  String
  entityId    String
  expiresAt   DateTime

  @@index([expiresAt])
}

/// In-app notification for one recipient about one task. Created by the
/// services next to the matching activity event; never for the actor's own
/// actions. Read access is re-checked when listing, so a user who loses
/// access to a project stops seeing its notifications.
model Notification {
  id          String    @id @default(uuid(7))
  userId      String
  workspaceId String
  projectId   String
  taskId      String
  actorId     String?
  /// task.assigned | task.status_changed | comment.created
  type        String
  /// Display details captured at the time: title, from/to, excerpt, commentId.
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
  @@index([userId, workspaceId, readAt])
  @@index([taskId])
}
